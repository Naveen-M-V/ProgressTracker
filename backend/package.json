{
  "name": "upsow-backend",
  "version": "1.0.0",
  "description": "Upsow Progress Tracker Express & SQLite Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx tests/phase0.test.ts && tsx tests/phase1.test.ts && tsx tests/phase2.test.ts && tsx tests/phase3.test.ts && tsx tests/phase5.test.ts && tsx tests/phase6.test.ts && tsx tests/phase7.test.ts",
    "test:phase0": "tsx tests/phase0.test.ts",
    "test:phase1": "tsx tests/phase1.test.ts",
    "test:phase2": "tsx tests/phase2.test.ts",
    "test:phase3": "tsx tests/phase3.test.ts",
    "test:phase5": "tsx tests/phase5.test.ts",
    "test:phase6": "tsx tests/phase6.test.ts",
    "test:phase7": "tsx tests/phase7.test.ts",
    "seed": "tsx src/db.ts --seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
